<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/ui_component_player_body" />

    <View
        android:id="@+id/queue_dismiss_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/queue_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_queue_sheet"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="22dp">

        <FrameLayout
            android:id="@+id/queue_drag_handle"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_sheet_handle" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="播放队列"
                    android:textColor="@color/zy_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="顺序播放 · 30 首"
                    android:textColor="@color/zy_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_card_soft"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="保存为歌单"
                android:textColor="@color/zy_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_segmented"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="⇄  随机"
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_segmented"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="↻  循环"
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_segmented"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="清空"
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <include layout="@layout/ui_queue_row_current" />
        <include layout="@layout/ui_queue_row_riverside" />
        <include layout="@layout/ui_queue_row_valley" />
        <include layout="@layout/ui_queue_row_quiet" />
    </LinearLayout>
</FrameLayout>
