<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zy_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/back_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_white"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/zy_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="连接 NAS"
                    android:textColor="@color/zy_ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="输入 DSM 地址，或选择局域网发现的设备。"
                    android:textColor="@color/zy_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/discovery_row"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_primary_soft"
                android:gravity="center"
                android:text="▰"
                android:textColor="@color/zy_cyan"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/discovery_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="局域网 NAS"
                    android:textColor="@color/zy_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/discovery_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:text="等待发现结果"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/discovery_status"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill_success"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="已发现"
                android:textColor="#047857"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/ZyFieldLabel" android:text="NAS 地址" />
        <EditText style="@style/ZyInput" android:text="https://home-nas.example.com:5001" />
        <TextView style="@style/ZyFieldLabel" android:text="账号" />
        <EditText style="@style/ZyInput" android:text="music_user" />
        <TextView style="@style/ZyFieldLabel" android:text="密码" />
        <EditText style="@style/ZyInput" android:hint="请输入密码" android:inputType="textPassword" />
        <TextView style="@style/ZyFieldLabel" android:text="两步验证码" />
        <EditText style="@style/ZyInput" android:hint="可选" />

        <TextView
            android:id="@+id/connect_primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="安全连接"
            android:textColor="@color/zy_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connect_offline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="仅离线模式进入"
            android:textColor="@color/zy_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
