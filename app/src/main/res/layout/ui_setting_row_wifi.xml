<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <TextView android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:text="≋" android:textColor="@color/zy_primary" android:textSize="18sp" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="仅 Wi-Fi 下载" android:textColor="#374151" android:textSize="14sp" android:textStyle="bold" />
    <FrameLayout
        android:id="@+id/wifi_download_toggle"
        android:layout_width="46dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_wifi_switch_track_on"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_wifi_switch_thumb" />
    </FrameLayout>
</LinearLayout>
