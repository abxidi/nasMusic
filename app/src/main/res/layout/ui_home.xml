<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zy_soft_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="154dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/home_hero"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_hero_home"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="44dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_ghost"
                        android:gravity="center"
                        android:text="云"
                        android:textColor="@color/zy_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="DiskStation-Home"
                            android:textColor="@color/zy_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="●  内网在线 · FLAC 原始播放"
                            android:textColor="#C2FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/home_search_button"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_ghost"
                        android:gravity="center"
                        android:text="⌕"
                        android:textColor="@color/zy_white"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/home_search_entry"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_search_pill"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="13dp"
                    android:text="⌕  搜索歌曲、歌手、文件夹"
                    android:textColor="#C7FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="14dp">

                <LinearLayout style="@style/ZySectionTitle">
                    <TextView style="@style/ZySectionHeading" android:text="今日推荐" />
                    <TextView style="@style/ZySectionMeta" android:text="本地元数据生成" />
                </LinearLayout>

                <include layout="@layout/ui_item_song_lake_lights" />
                <include layout="@layout/ui_item_song_south_flight" />
                <include layout="@layout/ui_item_song_private_cloud" />

                <LinearLayout
                    style="@style/ZySectionTitle"
                    android:layout_marginTop="18dp">
                    <TextView style="@style/ZySectionHeading" android:text="最近新增" />
                    <TextView style="@style/ZySectionMeta" android:text="12 张专辑" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="178dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <include layout="@layout/ui_item_album_archive" />
                        <include layout="@layout/ui_item_album_blue_room" />
                        <include layout="@layout/ui_item_album_valley" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/ui_component_mini_player" />
    <include layout="@layout/ui_component_bottom_nav_home" />
</FrameLayout>
