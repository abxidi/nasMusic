<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="34dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_player_down"
                android:tint="#B9B2C5" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="每日推荐"
                android:textColor="#B9B2C5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_player_refresh"
                android:tint="#B9B2C5" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="430dp">

            <com.ziyun.music.ui.RecordView
                android:id="@+id/player_record"
                android:layout_width="360dp"
                android:layout_height="420dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="午夜电台"
                    android:textColor="#D8D3E2"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/player_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="陈以北 · NAS"
                    android:textColor="#8F879D"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="2dp"
                    android:src="@drawable/ic_player_heart"
                    android:tint="#C8C2D2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="25w+"
                    android:textColor="#C8C2D2"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="2dp"
                    android:src="@drawable/ic_player_comment"
                    android:tint="#C8C2D2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="999+"
                    android:textColor="#C8C2D2"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="28dp"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_progress_track_dark" />

            <View
                android:layout_width="138dp"
                android:layout_height="2dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_progress_played" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="54dp"
                android:background="@drawable/bg_progress_thumb_light" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="136dp"
                android:background="@drawable/bg_progress_thumb_light" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginHorizontal="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:27"
                android:textColor="#777083"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="极高"
                android:textColor="#948CA0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="03:34"
                android:textColor="#777083"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/player_shuffle"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_player_shuffle"
                android:tint="#9D96A9" />

            <ImageView
                android:id="@+id/player_prev"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/ic_player_prev"
                android:tint="#D2CDD9" />

            <ImageView
                android:id="@+id/player_play"
                android:layout_width="76dp"
                android:layout_height="70dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_player_pause"
                android:tint="#D7D2DE" />

            <ImageView
                android:id="@+id/player_next"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/ic_player_next"
                android:tint="#D2CDD9" />

            <ImageView
                android:id="@+id/player_queue"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/ic_player_queue"
                android:tint="#9D96A9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="66dp"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/player_cast"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/ic_player_cast"
                android:tint="#827A8E" />

            <ImageView
                android:id="@+id/player_equalizer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/ic_player_sliders"
                android:tint="#827A8E" />

            <ImageView
                android:id="@+id/player_download"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/ic_player_more"
                android:tint="#827A8E" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
